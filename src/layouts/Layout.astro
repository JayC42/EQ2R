---
interface Props {
  title: string;
  activePage?: string;
  fullWidth?: boolean;
}

const { title, activePage = "/", fullWidth = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Equation to Reality — AI-powered physics tutor that reverse-engineers the real world" />
    <title>{title} | Equation to Reality</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <nav class="nav">
      <a href="/" class="nav-brand">
        <span>E2R</span> Equation to Reality
      </a>
      <div class="nav-links">
        <a href="/" class={`nav-link ${activePage === "/" ? "active" : ""}`}>
          📸 Upload
        </a>
        <a href="/graph" class={`nav-link ${activePage === "/graph" ? "active" : ""}`}>
          🔗 Knowledge Graph
        </a>
      </div>
    </nav>

    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
